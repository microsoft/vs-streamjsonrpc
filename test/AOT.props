<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>$(AvailableRuntimeIdentifiers)</RuntimeIdentifiers>
    <!-- The existing compatibility executable imports these props before its project body. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(MSBuildProjectName)' == 'NativeAOTCompatibility.Test'">$(DefaultRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Compatibility projects can override these defaults in their project files. -->
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">true</InvariantGlobalization>
    <SatelliteResourceLanguages Condition="'$(SatelliteResourceLanguages)' == ''">en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);RuntimeIdentifier;NativeAOT</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
